{
  "expo": {
    "name": "AchadosWebDev",
    "slug": "achados-webdev",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "backgroundColor": "#0D0E12"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para registrar seus achados."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita a localização para capturar a posição do achado."
        }
      ]
    ]
  }
}